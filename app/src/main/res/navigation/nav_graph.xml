<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/menuForTestFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_FourthFragment"
            app:destination="@id/FourthFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_SixthFragment"
            app:destination="@id/SixthFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_SplashFragment"
            app:destination="@id/SplashFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_EightFragment"
            app:destination="@id/EightFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_FifthFragment"
            app:destination="@id/FifthFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_menuForTestFragment"
            app:destination="@id/menuForTestFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_SeventhFragment"
            app:destination="@id/SeventhFragment" />
    </fragment>

    <fragment
        android:id="@+id/menuForTestFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.MenuForTestFragment"
        android:label="Menu For Test"
        tools:layout="@layout/fragment_menu_for_test">
        <action
            android:id="@+id/action_menuForTestFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
        <action
            android:id="@+id/action_menuForTestFragment_to_ThirdFragment"
            app:destination="@id/ThirdFragment" />
        <action
            android:id="@+id/action_menuForTestFragment_to_SplashFragment"
            app:destination="@id/SplashFragment" />
        <action
            android:id="@+id/action_menuForTestFragment_to_FifthFragment"
            app:destination="@id/FifthFragment" />
        <action
            android:id="@+id/action_menuForTestFragment_to_SeventhFragment"
            app:destination="@id/SeventhFragment" />
        <action
            android:id="@+id/action_menuForTestFragment_to_NinethFragment"
            app:destination="@id/NinethFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/FifthFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.FifthFragment"
        android:label="List for Tabs"
        tools:layout="@layout/fragment_fifth">
        <action
            android:id="@+id/action_FifthFragment_to_TenthFragment"
            app:destination="@id/TenthFragment" />
    </fragment>

    <fragment
        android:id="@+id/TenthFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.TenthFragment"
        android:label="Pokemon Master Detail"
        tools:layout="@layout/fragment_tenth">
        <argument
            android:name="id"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/SplashFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_SplashFragment_to_ThirdFragmentForSpinner"
            app:destination="@id/ThirdFragmentForSpinner" />
    </fragment>

    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">
        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
        <action
            android:id="@+id/action_SecondFragment_to_FourthFragment"
            app:destination="@id/FourthFragment" />
        <action
            android:id="@+id/action_SecondFragment_to_ThirdFragmentForSpinner"
            app:destination="@id/ThirdFragmentForSpinner" />
        <argument
            android:name="id"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/ThirdFragmentForSpinner"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.ThirdFragmentForSpinner"
        android:label="Spinner Fragment"
        tools:layout="@layout/fragment_third_for_spinner">
    </fragment>

    <fragment
        android:id="@+id/ThirdFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.ThirdFragment"
        android:label="Detailed List"
        tools:layout="@layout/fragment_third_list">
        <action
            android:id="@+id/action_ThirdFragment_to_SixthFragment"
            app:destination="@id/SixthFragment" />
        <action
            android:id="@+id/action_ThirdFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>

    <fragment
        android:id="@+id/FourthFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.FourthFragment"
        android:label="Fourth Fragment"
        tools:layout="@layout/fragment_fourth">
        <argument
            android:name="id"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/SixthFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.SixthFragment"
        android:label="Sixth Fragment"
        tools:layout="@layout/fragment_sixth">
        <argument
            android:name="id"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/EightFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.EightFragment"
        android:label="Movimentos"
        tools:layout="@layout/fragment_eight">
        <argument
            android:name="id"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/SeventhFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.SeventhFragment"
        android:label="Favoritos"
        tools:layout="@layout/fragment_seventh">
        <action
            android:id="@+id/action_SeventhFragment_to_TenthFragment"
            app:destination="@id/TenthFragment" />
    </fragment>

    <fragment
        android:id="@+id/NinethFragment"
        android:name="com.douglas2990.pokedexapimvvmcleanarchitecturehilt.presentation.ui.NinethFragment"
        android:label="Favoritos"
        tools:layout="@layout/fragment_seventh">
        <action
            android:id="@+id/action_NinethFragment_to_TenthFragment"
            app:destination="@id/TenthFragment" />

        <action
            android:id="@+id/action_NinethFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>

</navigation>
